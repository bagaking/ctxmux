{
  "name": "ctxmux-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Context-aware Run multiplexer",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "scripts/check.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "cargo build --quiet --package ctxmux --package ctxmux-daemon && CTXMUX_BIN=\"$PWD/target/debug/ctxmux\" CTXMUXD_BIN=\"$PWD/target/debug/ctxmuxd\" npm run test:e2e --workspace @ctxmux/sdk",
    "test:unit": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  }
}
