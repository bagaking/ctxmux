{
  "version": 1,
  "strict_mode_default": true,
  "git": {
    "branch_prefix": "feat/"
  },
  "workspace": {
    "default_mode": "proposal_only"
  },
  "stop_thresholds": {
    "gate_fail_streak": 3,
    "no_progress_rounds": 2,
    "max_round_count": 8
  },
  "gate": {
    "verification_policy": "on_demand"
  }
}
